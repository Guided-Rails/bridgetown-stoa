<!doctype html>
<html lang="{{ site.locale || 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% if resource.data.title != "Index" %}
        {{ resource.data.title }} |
      {% end %}
      {{ site.metadata.title }}
    </title>
    {% if resource.data.description %}
      <meta name="description" content="{{ resource.data.description }}">
    {% end %}
    <link rel="stylesheet" href="{%= asset_path :css %}">
  </head>
  <body class="stoa-shell">
    <aside class="stoa-sidebar-shell">
      <header class="stoa-brand">
        <a href="/" class="stoa-site-title">{{ site.metadata.title }}</a>
      </header>
      {%= render BridgetownStoa::Sidebar.new(site: site, current_resource: resource) %}
      {%= render BridgetownStoa::SidebarFooter.new %}
    </aside>
    <main class="stoa-main">
      <div class="stoa-content">
        {%= yield %}
      </div>
    </main>
    <script src="{%= asset_path :js %}" defer></script>
  </body>
</html>
